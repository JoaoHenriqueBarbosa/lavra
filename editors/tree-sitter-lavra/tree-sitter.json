{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "lavra",
      "camelcase": "Lavra",
      "title": "Lavra",
      "scope": "source.lavra",
      "path": ".",
      "file-types": ["lav"],
      "injection-regex": "^lavra$",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Gramática tree-sitter da Lavra, a linguagem compilada em que cada instrução é uma oração em português.",
    "authors": [
      {
        "name": "João Henrique Barbosa",
        "email": "joaohenriquebarbosa21@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/JoaoHenriqueBarbosa/lavra"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "kotlin": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
